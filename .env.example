# Copy to .env and fill in what you use. .env is git-ignored.
# Only these three keys are ever read from .env (everything else must come from the shell or ultron.toml).

# Claude (default provider when set)
ANTHROPIC_API_KEY=

# OpenAI, or any OpenAI-compatible server (also set ULTRON_MODEL and, for non-OpenAI servers, ULTRON_BASE_URL)
OPENAI_API_KEY=
ULTRON_API_KEY=
